---
import Base from '../layouts/Base.astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import Icono from '../components/Icono.astro';
import { enlaceWhatsapp } from '../data/site';
import { ruta } from '../lib/ruta';
---

<Base titulo="Página no encontrada | Fixtris Computer" descripcion="La página que buscás no existe o cambió de lugar.">
	<Cabecera />
	<main id="contenido" class="no-encontrada tema-oscuro">
		<div class="contenedor">
			<!-- Una pieza en T que quedó fuera del hueco: la página no encaja -->
			<div class="pieza-suelta" aria-hidden="true">
				<span></span><span></span><span></span><span></span>
			</div>
			<h1>Esta página no existe</h1>
			<p class="intro">
				Puede que el enlace esté mal escrito o que la página haya cambiado de lugar. Volvé al inicio o escribinos si
				buscabas algo en particular.
			</p>
			<div class="acciones">
				<a class="boton boton-accion" href={ruta('/')}>Volver al inicio</a>
				<a class="boton boton-secundario" href={enlaceWhatsapp()}>
					<Icono nombre="whatsapp" />
					Escribinos por WhatsApp
				</a>
			</div>
		</div>
	</main>
	<Pie />
</Base>

<style>
	.no-encontrada {
		min-height: 70svh;
		display: grid;
		align-items: center;
		padding-block: var(--seccion);
	}

	.pieza-suelta {
		display: grid;
		grid-template-columns: repeat(3, 2.25rem);
		gap: 0.3rem;
		margin-bottom: 2rem;
		transform: rotate(-12deg);
	}

	.pieza-suelta span {
		aspect-ratio: 1;
		border-radius: 15%;
		background: linear-gradient(135deg, var(--ambar-300), var(--ambar-500));
	}

	.pieza-suelta span:last-child {
		grid-column: 2;
	}

	h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	.acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.25rem;
	}

	@media (max-width: 600px) {
		.acciones {
			display: grid;
		}
		.acciones .boton {
			width: 100%;
			min-height: 3.5rem;
		}
	}
</style>
