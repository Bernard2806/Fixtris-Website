---
import { formasDePago, compromiso, precios } from '../data/site';
import { obtenerCotizacion, aPesos, formatearPesos } from '../lib/dolar';
import { anclaPrecios } from '../lib/ancla';
import Icono from './Icono.astro';

const cotizacion = await obtenerCotizacion();
// Una categoría con un solo precio (el diagnóstico) no se pliega: se ve siempre
const grupos = precios.map((g) => ({
	...g,
	id: anclaPrecios(g.categoria),
	fija: g.items.length === 1,
	items: g.items.map((p) => ({ ...p, pesos: formatearPesos(aPesos(p.usd, cotizacion)) })),
}));
const actualizado = cotizacion.fecha.toLocaleDateString('es-AR', {
	timeZone: 'America/Argentina/Buenos_Aires',
	day: '2-digit',
	month: '2-digit',
	year: 'numeric',
});
---

<section class="precios seccion tema-oscuro" id="precios" aria-labelledby="titulo-precios">
	<div class="contenedor">
		<h2 id="titulo-precios">Precios y formas de pago</h2>
		<p class="intro">
			Estos son los precios de los trabajos más pedidos. Para el resto te pasamos un presupuesto, y junto con el precio te
			decimos cuál de las formas de pago corresponde.
		</p>

		<div class="categorias">
			{
				grupos.map((g) => {
					const Categoria = g.fija ? 'div' : 'details';
					return (
						<Categoria class:list={['categoria', { 'categoria-fija': g.fija }]} id={g.id} open={!g.fija}>
							{g.fija ? (
								<h3>{g.categoria}</h3>
							) : (
								<summary>
									<span class="cabeza">
										<h3>{g.categoria}</h3>
										<span class="cantidad">{g.items.length} precios</span>
									</span>
									<span class="signo">
										<Icono nombre="plus" />
									</span>
								</summary>
							)}
							{g.aclaracion && <p class="aclaracion">{g.aclaracion}</p>}
							<ul>
								{g.items.map((p) => (
									<li class="precio">
										<span class="servicio">{p.servicio}</span>
										<strong class="monto">{p.pesos}</strong>
										{p.detalle && <p>{p.detalle}</p>}
									</li>
								))}
							</ul>
						</Categoria>
					);
				})
			}
		</div>
		<script is:inline>
			// En celular los grupos arrancan cerrados para que la lista no sea eterna.
			// Sin JavaScript quedan todos abiertos.
			if (matchMedia('(max-width: 860px)').matches) {
				document.querySelectorAll('#precios details.categoria').forEach((d) => d.removeAttribute('open'));
			}
			// Los enlaces "Ver precios" de los servicios abren el grupo al que llevan
			{
				const abrir = (hash) => {
					const grupo = hash && document.getElementById(decodeURIComponent(hash.slice(1)));
					if (grupo instanceof HTMLDetailsElement && grupo.matches('#precios details')) grupo.open = true;
				};
				abrir(location.hash);
				document.addEventListener('click', (e) => {
					const enlace = e.target instanceof Element && e.target.closest('a[href^="#precios-"]');
					if (enlace) abrir(enlace.getAttribute('href'));
				});
			}
		</script>
		<p class="nota">Precios actualizados al {actualizado}.</p>

		<h3 class="subtitulo">Formas de pago</h3>
		<ul class="formas">
			{
				formasDePago.map((f) => (
					<li class="forma">
						<span class="forma-icono">
							<Icono nombre={f.icono} />
						</span>
						<h4>{f.titulo}</h4>
						<p>{f.texto}</p>
					</li>
				))
			}
		</ul>

		<div class="compromiso">
			<span class="compromiso-icono">
				<Icono nombre="hand-raised" />
			</span>
			<div>
				<h3>{compromiso.titulo}</h3>
				<p>{compromiso.texto}</p>
			</div>
		</div>
	</div>
</section>

<style>
	/* Columnas tipo mampostería: las tarjetas tienen distinto alto y así no quedan huecos */
	.categorias {
		columns: 2;
		column-gap: 1rem;
		margin-top: clamp(2.5rem, 5vw, 3.5rem);
	}

	.categoria {
		break-inside: avoid;
		margin-bottom: 1rem;
		padding: 1.25rem 1.25rem 0.5rem;
		border: 1px solid var(--sup-borde-osc);
		border-radius: 10px;
		background: var(--sup-alt);
	}

	.categoria summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		cursor: pointer;
		list-style: none;
	}

	.categoria summary::-webkit-details-marker {
		display: none;
	}

	.cabeza {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.2rem 0.75rem;
	}

	.categoria h3 {
		color: var(--azul-300);
	}

	.cantidad {
		color: var(--suave);
		font-size: 0.9375rem;
	}

	/* El + gira hasta ser una × al abrir el grupo, como en las preguntas frecuentes */
	.signo {
		display: grid;
		place-items: center;
		flex: none;
		color: var(--azul-300);
		transition: transform 0.25s ease;
	}

	.categoria[open] .signo {
		transform: rotate(45deg);
	}

	details.categoria:not([open]) {
		padding-bottom: 1.25rem;
	}

	.aclaracion {
		margin-top: 0.4rem;
		color: var(--suave);
		font-size: 0.9375rem;
	}

	.categoria ul {
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	/* Servicio y precio en la misma línea; el detalle abajo, a todo el ancho */
	.precio {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: baseline;
		column-gap: 1rem;
		padding-block: 0.85rem;
	}

	.precio + .precio {
		border-top: 1px solid var(--sup-borde-osc);
	}

	.servicio {
		font: 700 1.0625rem/1.3 var(--fuente-titulos);
		color: var(--titulo);
	}

	.precio p {
		grid-column: 1 / -1;
		margin-top: 0.3rem;
		color: var(--suave);
		font-size: 0.9375rem;
	}

	.monto {
		font: 700 1.25rem/1.2 var(--fuente-titulos);
		color: var(--titulo);
		white-space: nowrap;
	}

	.nota {
		margin-top: 0.75rem;
		color: var(--suave);
		font-size: 0.9375rem;
	}

	.subtitulo {
		margin-top: clamp(3rem, 6vw, 4.5rem);
		font-size: 1.5rem;
	}

	.formas {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.forma {
		display: grid;
		align-content: start;
		gap: 0.6rem;
		padding: 1.5rem;
		border: 1px solid var(--sup-borde-osc);
		border-radius: 10px;
		background: var(--sup-alt);
	}

	.forma-icono,
	.compromiso-icono {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		margin-bottom: 0.4rem;
		border-radius: 8px;
		background: var(--azul-950);
		color: var(--azul-300);
	}

	.forma p {
		color: var(--suave);
	}

	/* El aviso de compromiso: el borde azul lo separa de las tarjetas sin usar el ámbar de las acciones */
	.compromiso {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
		margin-top: 1rem;
		padding: 1.5rem;
		border: 1px solid var(--azul-700);
		border-left: 4px solid var(--azul-400);
		border-radius: 10px;
		background: color-mix(in oklab, var(--azul-500) 10%, var(--sup-base));
	}

	.compromiso-icono {
		flex: none;
		margin-bottom: 0;
		background: var(--azul-900);
	}

	.compromiso p {
		max-width: 46rem;
		margin-top: 0.4rem;
		color: var(--texto);
	}

	@media (max-width: 860px) {
		.categorias {
			columns: 1;
		}
		.formas {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}
		/* En celular el ícono va al costado para que las tarjetas sean más bajas */
		.forma {
			grid-template-columns: auto minmax(0, 1fr);
			grid-template-areas: 'icono titulo' 'texto texto';
			align-items: center;
			column-gap: 1rem;
			row-gap: 0.75rem;
			padding: 1.25rem;
		}
		.forma-icono {
			grid-area: icono;
			margin-bottom: 0;
		}
		.forma h4 {
			grid-area: titulo;
		}
		.forma p {
			grid-area: texto;
		}
	}

	@media (max-width: 480px) {
		.compromiso {
			flex-direction: column;
			gap: 0.9rem;
		}
	}
</style>
