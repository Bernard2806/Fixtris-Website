---
import Icono from './Icono.astro';

// El isotipo de Fixtris convertido en un pequeño juego: la pieza en T
// tiene que encajar en el hueco para completar las líneas (= arreglar la compu).
// Sin JavaScript se ve igual que el logo.

const COLS = 6;
const FILAS = 6;

// Estado inicial: el mismo dibujo del logo
const huecoC = 2;
const pila: number[][] = Array.from({ length: FILAS }, () => Array(COLS).fill(0));
for (let x = 0; x < COLS; x++) {
	if (x !== huecoC) pila[FILAS - 1][x] = 2;
	if (Math.abs(x - huecoC) > 1) pila[FILAS - 2][x] = 1;
}
pila[FILAS - 3][4] = 1;

const pieza = new Set([0 * COLS + 1, 0 * COLS + 2, 0 * COLS + 3, 1 * COLS + 2]);
const hueco = new Set([
	(FILAS - 2) * COLS + huecoC - 1,
	(FILAS - 2) * COLS + huecoC,
	(FILAS - 2) * COLS + huecoC + 1,
	(FILAS - 1) * COLS + huecoC,
]);

const celdas = Array.from({ length: COLS * FILAS }, (_, i) => {
	const v = pila[Math.floor(i / COLS)][i % COLS];
	if (pieza.has(i)) return 'celda es-pieza';
	if (v === 1) return 'celda es-b1';
	if (v === 2) return 'celda es-b2';
	if (hueco.has(i)) return 'celda es-hueco';
	return 'celda';
});

const patas = [-56, 0, 56];
---

<div
	class="juego"
	data-juego
	tabindex="0"
	role="group"
	aria-roledescription="juego"
	aria-label="Encajá la pieza: mové la pieza en T hasta el hueco y soltala para completar la línea"
	aria-describedby="juego-ayuda"
>
	<div class="chip" data-chip>
		<svg class="chip-dibujo" viewBox="-134 -134 268 268" aria-hidden="true" focusable="false">
			<defs>
				<linearGradient id="hc-llave" gradientUnits="userSpaceOnUse" x1="-32.53" y1="-32.53" x2="32.53" y2="32.53">
					<stop offset="0" stop-color="#cfefff"></stop>
					<stop offset="1" stop-color="#06bbf1"></stop>
				</linearGradient>
				<mask id="hc-recorte" maskUnits="userSpaceOnUse" x="-200" y="-200" width="400" height="400">
					<rect x="-200" y="-200" width="400" height="400" fill="#fff"></rect>
					<rect x="-125" y="-125" width="250" height="250" rx="37" fill="#000"></rect>
					<g fill="#000" stroke="#000" stroke-width="18">
						{
							patas.map((p) => (
								<>
									<rect x={p - 8} y="-134" width="16" height="36" rx="4" />
									<rect x={p - 8} y="98" width="16" height="36" rx="4" />
									<rect x="-134" y={p - 8} width="36" height="16" rx="4" />
									<rect x="98" y={p - 8} width="36" height="16" rx="4" />
								</>
							))
						}
					</g>
				</mask>
			</defs>
			<g class="llave" data-llave>
				<path
					d="M-118.74 97.52L92.99 -114.21A46 46 0 0 1 152.55 -176.6L113.84 -137.89L137.89 -113.84L176.6 -152.55A46 46 0 0 1 114.21 -92.99L-97.52 118.74A40 40 0 1 1 -118.74 97.52ZM-120.21 120.21L-115.03 139.53L-129.17 153.67L-148.49 148.49L-153.67 129.17L-139.53 115.03Z"
					fill-rule="evenodd"
					fill="url(#hc-llave)"
					mask="url(#hc-recorte)"></path>
			</g>
			<g fill="#ebf8ff">
				{
					patas.map((p) => (
						<>
							<rect x={p - 8} y="-134" width="16" height="36" rx="4" />
							<rect x={p - 8} y="98" width="16" height="36" rx="4" />
							<rect x="-134" y={p - 8} width="36" height="16" rx="4" />
							<rect x="98" y={p - 8} width="36" height="16" rx="4" />
						</>
					))
				}
			</g>
			<rect x="-110" y="-110" width="220" height="220" rx="22" fill="#00212f" stroke="#ebf8ff" stroke-width="12"></rect>
		</svg>
		<div class="grilla" data-grilla aria-hidden="true">
			{celdas.map((c) => <div class={c} />)}
		</div>
	</div>

	<div class="juego-pie">
		<p class="estado" data-estado aria-live="polite">Encajá la pieza en el hueco.</p>
		<div class="controles">
			<button type="button" class="control" data-accion="izq" aria-label="Mover a la izquierda">
				<Icono nombre="chevron-left" />
			</button>
			<button type="button" class="control" data-accion="girar" aria-label="Girar la pieza">
				<Icono nombre="arrow-path" />
			</button>
			<button type="button" class="control" data-accion="der" aria-label="Mover a la derecha">
				<Icono nombre="chevron-right" />
			</button>
			<button type="button" class="control control-soltar" data-accion="soltar">
				<Icono nombre="arrow-down" />
				Soltar
			</button>
		</div>
		<p class="ayuda ayuda-teclado" id="juego-ayuda">
			También con el teclado: <kbd>←</kbd> <kbd>→</kbd> mover, <kbd>↑</kbd> girar, <kbd>↓</kbd> soltar.
		</p>
		<p class="ayuda ayuda-tactil">Tocá el chip para girar la pieza y deslizá para moverla.</p>
		<p class="marcador">Compus arregladas: <b data-contador>0</b></p>
	</div>
</div>

<style>
	.juego {
		--celda-radio: 15%;
		display: grid;
		gap: clamp(1.25rem, 3vw, 2rem);
		justify-items: center;
		border-radius: 12px;
		outline-offset: 8px;
	}

	.chip {
		position: relative;
		/* Deja hacer scroll vertical; los gestos horizontales y los toques mueven la pieza */
		touch-action: pan-y;
		user-select: none;
		-webkit-tap-highlight-color: transparent;
		width: min(100%, 25rem, 52svh);
		min-width: min(100%, 17rem);
		aspect-ratio: 1;
	}

	.chip-dibujo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.llave {
		transform-box: view-box;
		transform-origin: 50% 50%;
	}

	.llave.gira {
		animation: girar-llave 0.7s cubic-bezier(0.3, 1.4, 0.5, 1);
	}

	@keyframes girar-llave {
		40% {
			transform: rotate(-16deg);
		}
	}

	/* La grilla ocupa el cuerpo del chip: 176 de 268 unidades */
	.grilla {
		position: absolute;
		inset: 17.16%;
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		grid-template-rows: repeat(6, 1fr);
		gap: 2.27%;
	}

	.celda {
		border-radius: var(--celda-radio);
	}

	.es-b1 {
		background: var(--azul-500);
	}

	.es-b2 {
		background: var(--azul-700);
	}

	.es-hueco {
		box-shadow: inset 0 0 0 2px var(--ambar-400);
	}

	.es-pieza {
		background: linear-gradient(135deg, var(--ambar-300), var(--ambar-500));
	}

	.se-limpia {
		animation: limpiar 0.6s ease-in forwards;
	}

	@keyframes limpiar {
		0% {
			background: #fff;
			box-shadow: 0 0 18px var(--ambar-300);
		}
		100% {
			background: #fff;
			transform: scale(0.2);
			opacity: 0;
		}
	}

	.chip.fallo {
		animation: sacudir 0.4s;
	}

	@keyframes sacudir {
		25% {
			transform: translateX(-6px);
		}
		50% {
			transform: translateX(5px);
		}
		75% {
			transform: translateX(-3px);
		}
	}

	.juego-pie {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: 0.85rem;
		text-align: center;
	}

	.estado {
		font: 700 1.125rem/1.3 var(--fuente-titulos);
		color: var(--titulo);
		min-height: 1.3em;
	}

	.controles {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
	}

	.control {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		min-width: 3rem;
		height: 3rem;
		padding: 0 0.85rem;
		border: 1px solid var(--sup-borde-osc);
		border-radius: var(--radio);
		background: var(--sup-tarjeta);
		color: var(--azul-100);
		font: 700 1rem/1 var(--fuente-titulos);
		cursor: pointer;
		touch-action: manipulation;
		transition:
			background-color 0.12s,
			transform 0.08s;
	}

	.control:hover {
		background: #1a3540;
	}

	.control:active {
		transform: translateY(2px);
	}

	.control-soltar {
		background: var(--ambar-400);
		border-color: var(--ambar-400);
		color: var(--azul-950);
	}

	.control-soltar:hover {
		background: var(--ambar-300);
	}

	.ayuda {
		font-size: 0.875rem;
		color: var(--suave);
		max-width: 28rem;
	}

	kbd {
		display: inline-block;
		padding: 0 0.35em;
		border: 1px solid var(--sup-borde-osc);
		border-bottom-width: 2px;
		border-radius: 4px;
		font: inherit;
		color: var(--texto);
	}

	.ayuda-tactil {
		display: none;
	}

	/* Celular: solo la ilustración, más chica y sin controles */
	@media (max-width: 860px) {
		.juego-pie {
			display: none;
		}
		.chip {
			width: min(78%, 18rem);
			min-width: 0;
			touch-action: auto;
		}
	}

	@media (hover: none) {
		.ayuda-teclado {
			display: none;
		}
		.ayuda-tactil {
			display: block;
		}
	}

	.marcador {
		font-size: 0.9375rem;
		color: var(--suave);
	}

	.marcador b {
		font-family: var(--fuente-titulos);
		color: var(--ambar-300);
		font-size: 1.125rem;
	}
</style>

<script>
	const COLS = 6;
	const FILAS = 6;
	// Las cuatro orientaciones de la T, como [fila, columna] alrededor del centro
	const ROTACIONES: [number, number][][] = [
		[[0, -1], [0, 0], [0, 1], [1, 0]],
		[[-1, 0], [0, 0], [1, 0], [0, -1]],
		[[0, -1], [0, 0], [0, 1], [-1, 0]],
		[[-1, 0], [0, 0], [1, 0], [0, 1]],
	];

	type Pieza = { f: number; c: number; rot: number };

	const espera = (ms: number) => new Promise((r) => setTimeout(r, ms));
	const azar = (min: number, max: number) => min + Math.floor(Math.random() * (max - min + 1));

	function iniciar(raiz: HTMLElement) {
		const chip = raiz.querySelector<HTMLElement>('[data-chip]')!;
		const celdas = [...raiz.querySelectorAll<HTMLElement>('[data-grilla] > .celda')];
		const estado = raiz.querySelector<HTMLElement>('[data-estado]')!;
		const contador = raiz.querySelector<HTMLElement>('[data-contador]')!;
		const llave = raiz.querySelector<SVGGElement>('[data-llave]')!;
		const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
		// En celular el chip es solo una ilustración: la pieza cae una vez y vuelve al logo
		const vitrina = matchMedia('(max-width: 860px)').matches;

		let pila: number[][] = [];
		let huecoC = 2;
		let extras: number[] = [];
		let pieza: Pieza = { f: 0, c: 2, rot: 0 };
		let piezaVisible = true;
		let ocupado = false;
		let arregladas = 0;

		const celdasDe = (p: Pieza) => ROTACIONES[p.rot].map(([df, dc]) => [p.f + df, p.c + dc] as const);
		const valida = (p: Pieza) =>
			celdasDe(p).every(([f, c]) => f >= 0 && f < FILAS && c >= 0 && c < COLS && !pila[f][c]);

		function armar() {
			pila = Array.from({ length: FILAS }, () => Array(COLS).fill(0));
			for (let x = 0; x < COLS; x++) {
				if (x !== huecoC) pila[FILAS - 1][x] = 2;
				if (Math.abs(x - huecoC) > 1) pila[FILAS - 2][x] = 1;
			}
			for (const x of extras) pila[FILAS - 3][x] = 1;
		}

		function aparecer() {
			let p: Pieza;
			do {
				p = { f: 1, c: azar(1, COLS - 2), rot: azar(0, 3) };
			} while (p.c === huecoC && p.rot === 0);
			pieza = p;
			piezaVisible = true;
		}

		function nuevoProblema() {
			huecoC = azar(1, COLS - 2);
			const libres = [...Array(COLS).keys()].filter((x) => Math.abs(x - huecoC) > 1);
			extras = libres.filter(() => Math.random() < 0.45).slice(0, 2);
			armar();
			aparecer();
		}

		function dibujar() {
			const enPieza = new Set(piezaVisible ? celdasDe(pieza).map(([f, c]) => f * COLS + c) : []);
			const hueco = new Set([
				(FILAS - 2) * COLS + huecoC - 1,
				(FILAS - 2) * COLS + huecoC,
				(FILAS - 2) * COLS + huecoC + 1,
				(FILAS - 1) * COLS + huecoC,
			]);
			celdas.forEach((el, i) => {
				const v = pila[Math.floor(i / COLS)][i % COLS];
				let clase = 'celda';
				if (enPieza.has(i) || v === 3) clase += ' es-pieza';
				else if (v === 1) clase += ' es-b1';
				else if (v === 2) clase += ' es-b2';
				else if (hueco.has(i)) clase += ' es-hueco';
				el.className = clase;
			});
		}

		function anunciar(texto: string) {
			estado.textContent = texto;
		}

		function mover(dc: number) {
			if (ocupado) return;
			const p = { ...pieza, c: pieza.c + dc };
			if (valida(p)) {
				pieza = p;
				dibujar();
			}
		}

		function girar() {
			if (ocupado) return;
			const rot = (pieza.rot + 1) % 4;
			for (const dc of [0, -1, 1]) {
				const p = { ...pieza, rot, c: pieza.c + dc };
				if (valida(p)) {
					pieza = p;
					dibujar();
					return;
				}
			}
		}

		async function soltar(demo = false) {
			if (ocupado) return;
			ocupado = true;

			while (valida({ ...pieza, f: pieza.f + 1 })) {
				pieza = { ...pieza, f: pieza.f + 1 };
				if (!quieto) {
					dibujar();
					await espera(55);
				}
			}
			for (const [f, c] of celdasDe(pieza)) pila[f][c] = 3;
			piezaVisible = false;
			dibujar();

			const llenas = pila.flatMap((fila, i) => (fila.every(Boolean) ? [i] : []));

			if (llenas.length === 2) {
				for (const f of llenas) {
					for (let c = 0; c < COLS; c++) celdas[f * COLS + c].classList.add('se-limpia');
				}
				llave.classList.remove('gira');
				void llave.getBoundingClientRect();
				llave.classList.add('gira');

				if (demo) {
					anunciar('Así se arregla. Ahora probá vos.');
				} else {
					arregladas++;
					contador.textContent = String(arregladas);
					anunciar(arregladas === 1 ? '¡Arreglada! Ya va una.' : `¡Arreglada! Ya van ${arregladas}.`);
				}
				await espera(quieto ? 250 : 700);
				if (vitrina) estadoLogo();
				else nuevoProblema();
			} else {
				anunciar(llenas.length === 1 ? 'Casi: quedó un hueco abajo. Probá de nuevo.' : 'Así no encaja. Probá de nuevo.');
				if (!quieto) {
					chip.classList.remove('fallo');
					void chip.offsetWidth;
					chip.classList.add('fallo');
				}
				await espera(1100);
				armar();
				aparecer();
			}

			dibujar();
			ocupado = false;
		}

		function estadoLogo() {
			huecoC = 2;
			extras = [4];
			armar();
			pieza = { f: 0, c: 2, rot: 0 };
			piezaVisible = true;
		}

		// Arranca igual que el logo; la pieza cae sola una vez para mostrar la idea.
		estadoLogo();
		dibujar();

		if (vitrina) {
			// Sin controles: el chip es decorativo para lectores de pantalla y teclado
			raiz.removeAttribute('tabindex');
			raiz.removeAttribute('role');
			raiz.removeAttribute('aria-roledescription');
			raiz.removeAttribute('aria-label');
			raiz.removeAttribute('aria-describedby');
			raiz.setAttribute('aria-hidden', 'true');
			if (!quieto) setTimeout(() => soltar(true), 1200);
			return;
		}

		raiz.addEventListener('keydown', (e) => {
			const tecla = e.key;
			if (tecla === 'ArrowLeft') mover(-1);
			else if (tecla === 'ArrowRight') mover(1);
			else if (tecla === 'ArrowUp') girar();
			else if (tecla === 'ArrowDown' || (tecla === ' ' && e.target === raiz)) soltar();
			else return;
			e.preventDefault();
		});

		raiz.querySelectorAll<HTMLButtonElement>('[data-accion]').forEach((b) => {
			b.addEventListener('click', () => {
				const accion = b.dataset.accion;
				if (accion === 'izq') mover(-1);
				else if (accion === 'der') mover(1);
				else if (accion === 'girar') girar();
				else if (accion === 'soltar') soltar();
			});
		});

		// Gestos táctiles (tablets): tocar gira, deslizar de costado mueve
		let inicio: { x: number; y: number; id: number } | null = null;
		const grilla = raiz.querySelector<HTMLElement>('[data-grilla]')!;
		chip.addEventListener('pointerdown', (e) => {
			if (e.pointerType === 'mouse') return;
			inicio = { x: e.clientX, y: e.clientY, id: e.pointerId };
		});
		chip.addEventListener('pointercancel', () => (inicio = null));
		chip.addEventListener('pointerup', (e) => {
			if (!inicio || e.pointerId !== inicio.id) return;
			const dx = e.clientX - inicio.x;
			const dy = e.clientY - inicio.y;
			inicio = null;
			const celda = grilla.clientWidth / COLS;
			if (Math.abs(dx) < 12 && Math.abs(dy) < 12) {
				girar();
			} else if (Math.abs(dx) > Math.abs(dy)) {
				const pasos = Math.max(1, Math.round(Math.abs(dx) / celda));
				for (let i = 0; i < pasos; i++) mover(Math.sign(dx));
			}
		});

		if (quieto) {
			nuevoProblema();
			dibujar();
		} else {
			setTimeout(() => soltar(true), 1200);
		}
	}

	document.querySelectorAll<HTMLElement>('[data-juego]').forEach(iniciar);
</script>
