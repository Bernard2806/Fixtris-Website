---
// El isotipo de Fixtris dibujado en el hero: un chip con la llave cruzada detrás
// y, adentro, la pieza en T que cae para completar la línea de bloques.

const COLS = 6;
const FILAS = 6;

const huecoC = 2;
const pila: number[][] = Array.from({ length: FILAS }, () => Array(COLS).fill(0));
for (let x = 0; x < COLS; x++) {
	if (x !== huecoC) pila[FILAS - 1][x] = 2;
	if (Math.abs(x - huecoC) > 1) pila[FILAS - 2][x] = 1;
}
pila[FILAS - 3][4] = 1;

const pieza = new Set([0 * COLS + 1, 0 * COLS + 2, 0 * COLS + 3, 1 * COLS + 2]);
const hueco = new Set([
	(FILAS - 2) * COLS + huecoC - 1,
	(FILAS - 2) * COLS + huecoC,
	(FILAS - 2) * COLS + huecoC + 1,
	(FILAS - 1) * COLS + huecoC,
]);

const celdas = Array.from({ length: COLS * FILAS }, (_, i) => {
	const v = pila[Math.floor(i / COLS)][i % COLS];
	if (pieza.has(i)) return 'celda es-pieza';
	if (v === 1) return 'celda es-b1';
	if (v === 2) return 'celda es-b2';
	if (hueco.has(i)) return 'celda es-hueco';
	return 'celda';
});

const patas = [-56, 0, 56];
---

{/* Decorativo: el logo con nombre ya está en la cabecera */}
<div class="chip" aria-hidden="true">
	<svg class="chip-dibujo" viewBox="-134 -134 268 268" aria-hidden="true" focusable="false">
		<defs>
			<linearGradient id="hc-llave" gradientUnits="userSpaceOnUse" x1="-32.53" y1="-32.53" x2="32.53" y2="32.53">
				<stop offset="0" stop-color="#cfefff"></stop>
				<stop offset="1" stop-color="#06bbf1"></stop>
			</linearGradient>
			<mask id="hc-recorte" maskUnits="userSpaceOnUse" x="-200" y="-200" width="400" height="400">
				<rect x="-200" y="-200" width="400" height="400" fill="#fff"></rect>
				<rect x="-125" y="-125" width="250" height="250" rx="37" fill="#000"></rect>
				<g fill="#000" stroke="#000" stroke-width="18">
					{
						patas.map((p) => (
							<>
								<rect x={p - 8} y="-134" width="16" height="36" rx="4" />
								<rect x={p - 8} y="98" width="16" height="36" rx="4" />
								<rect x="-134" y={p - 8} width="36" height="16" rx="4" />
								<rect x="98" y={p - 8} width="36" height="16" rx="4" />
							</>
						))
					}
				</g>
			</mask>
		</defs>
		<g>
			<path
				d="M-118.74 97.52L92.99 -114.21A46 46 0 0 1 152.55 -176.6L113.84 -137.89L137.89 -113.84L176.6 -152.55A46 46 0 0 1 114.21 -92.99L-97.52 118.74A40 40 0 1 1 -118.74 97.52ZM-120.21 120.21L-115.03 139.53L-129.17 153.67L-148.49 148.49L-153.67 129.17L-139.53 115.03Z"
				fill-rule="evenodd"
				fill="url(#hc-llave)"
				mask="url(#hc-recorte)"></path>
		</g>
		<g fill="#ebf8ff">
			{
				patas.map((p) => (
					<>
						<rect x={p - 8} y="-134" width="16" height="36" rx="4" />
						<rect x={p - 8} y="98" width="16" height="36" rx="4" />
						<rect x="-134" y={p - 8} width="36" height="16" rx="4" />
						<rect x="98" y={p - 8} width="36" height="16" rx="4" />
					</>
				))
			}
		</g>
		<rect x="-110" y="-110" width="220" height="220" rx="22" fill="#00212f" stroke="#ebf8ff" stroke-width="12"></rect>
	</svg>
	<div class="grilla">
		{celdas.map((c) => <div class={c} />)}
	</div>
</div>

<style>
	.chip {
		--celda-radio: 15%;
		position: relative;
		width: min(100%, 25rem, 60svh);
		aspect-ratio: 1;
		margin-inline: auto;
	}

	.chip-dibujo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	/* La grilla ocupa el cuerpo del chip: 176 de 268 unidades */
	.grilla {
		position: absolute;
		inset: 17.16%;
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		grid-template-rows: repeat(6, 1fr);
		gap: 2.27%;
	}

	.celda {
		border-radius: var(--celda-radio);
	}

	.es-b1 {
		background: var(--azul-500);
	}

	.es-b2 {
		background: var(--azul-700);
	}

	.es-hueco {
		box-shadow: inset 0 0 0 2px var(--ambar-400);
	}

	.es-pieza {
		background: linear-gradient(135deg, var(--ambar-300), var(--ambar-500));
	}

	/* Celular: más chico, para que los servicios asomen antes */
	@media (max-width: 860px) {
		.chip {
			width: min(64%, 14.5rem);
		}
	}
</style>
