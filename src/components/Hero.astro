---
import Isotipo from './Isotipo.astro';
import Icono from './Icono.astro';
import { enlaceWhatsapp, precios } from '../data/site';
import { anclaPrecios } from '../lib/ancla';
import { obtenerCotizacion, aPesos, formatearPesos } from '../lib/dolar';

// El precio del diagnóstico, el mismo de la lista de precios, a la vista desde el primer momento
const grupoDiagnostico = precios.find((g) => g.items.some((p) => p.servicio === 'Diagnóstico'));
const diagnostico = grupoDiagnostico?.items.find((p) => p.servicio === 'Diagnóstico');
const cotizacion = await obtenerCotizacion();
const montoDiagnostico = diagnostico && formatearPesos(aPesos(diagnostico.usd, cotizacion));
---

<div class="hero tema-oscuro">
	<section class="portada contenedor" id="contenido" aria-labelledby="titulo-portada">
		<div class="portada-texto">
			<h1 id="titulo-portada">Arreglamos tu compu pieza por pieza<span class="bloque" aria-hidden="true"></span></h1>
			<p class="bajada">
				Reparación de notebooks, PC, consolas y hardware, y desbloqueo de netbooks del gobierno. Primero te decimos
				qué falla y cuánto sale; recién con tu OK lo arreglamos.
			</p>
			{
				montoDiagnostico && grupoDiagnostico && (
					<p class="diagnostico">
						El diagnóstico sale <a href={`#${anclaPrecios(grupoDiagnostico.categoria)}`} class="monto">{montoDiagnostico}</a> y se
						descuenta si hacés la reparación con nosotros.
					</p>
				)
			}
			<div class="acciones">
				<a class="boton boton-accion" href={enlaceWhatsapp()} data-cta-principal>
					<Icono nombre="whatsapp" />
					Escribinos por WhatsApp
				</a>
				<a class="boton boton-secundario" href="#precios">Ver precios</a>
			</div>
		</div>
		<div class="portada-logo">
			<Isotipo />
		</div>
	</section>
</div>

<style>
	.hero {
		position: relative;
		overflow: clip;
		background:
			radial-gradient(60rem 40rem at 78% 45%, rgb(10 163 211 / 0.13), transparent 65%),
			var(--sup-base);
	}

	.portada {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		align-items: center;
		gap: clamp(2rem, 5vw, 5rem);
		padding-block: clamp(2rem, 4vw, 3.5rem) clamp(4rem, 8vw, 6rem);
	}

	h1 {
		font-size: clamp(2.75rem, 5.6vw, 4.6rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.025em;
	}

	/* El punto final es un bloque, como los puntos de las i del logo */
	.bloque {
		display: inline-block;
		width: 0.17em;
		height: 0.17em;
		margin-left: 0.06em;
		border-radius: 0.025em;
		background: var(--azul-400);
	}

	.bajada {
		max-width: 32rem;
		margin-top: 1.5rem;
		font-size: clamp(1.125rem, 1.6vw, 1.25rem);
		color: var(--suave);
	}

	/* El precio es un dato, no un adorno: va en el texto, con el monto en Quicksand */
	.diagnostico {
		max-width: 32rem;
		margin-top: 1.25rem;
		color: var(--texto);
	}

	.monto {
		font: 700 1.25rem/1 var(--fuente-titulos);
		color: var(--titulo);
		white-space: nowrap;
		text-decoration: underline;
		text-decoration-color: var(--azul-400);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.2em;
	}

	.monto:hover {
		color: var(--azul-300);
	}

	.acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	/* Notebooks de pantalla baja (1366×768 y similares): el texto se compacta
	   para que el botón de WhatsApp quede a la vista sin bajar */
	@media (min-width: 961px) and (max-height: 820px) {
		.portada {
			padding-top: 1.5rem;
		}
		h1 {
			font-size: clamp(2.75rem, 4.6vw, 3.9rem);
		}
		.bajada {
			margin-top: 1.25rem;
		}
		.acciones {
			margin-top: 1.5rem;
		}
	}

	@media (max-width: 960px) {
		.portada {
			grid-template-columns: 1fr;
			padding-top: 1rem;
			padding-bottom: 3rem;
		}
		/* La llave sobresale del chip ~17% de su ancho (arriba a la derecha):
		   este aire evita que tape los botones de arriba */
		.portada-logo {
			max-width: 26rem;
			width: 100%;
			margin-inline: auto;
			padding-top: 2.5rem;
		}
	}

	/* Una sola columna: los dos botones con el mismo ancho, alineados al texto */
	@media (max-width: 960px) {
		.acciones {
			display: grid;
			grid-template-columns: 1fr;
		}
		.acciones .boton {
			width: 100%;
			min-height: 3.5rem;
		}
	}

	@media (min-width: 720px) and (max-width: 960px) {
		.acciones {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
