---
import { servicios, precios } from '../data/site';
import { anclaPrecios } from '../lib/ancla';
import Icono from './Icono.astro';

// Cada servicio lleva a su categoría de precios; si el nombre no existe, que falle al compilar
const categorias = new Set(precios.map((g) => g.categoria));
for (const s of servicios) {
	if (s.precios && !categorias.has(s.precios)) {
		throw new Error(`El servicio "${s.titulo}" apunta a la categoría de precios "${s.precios}", que no existe.`);
	}
}

// Alterna los tonos en damero, fila por fila (cada fila suma 6 columnas)
let fila = 0;
let suma = 0;
let posicion = 0;
const piezas = servicios.map((s) => {
	const honda = (fila + posicion) % 2 === 1;
	suma += s.ancho;
	posicion++;
	if (suma >= 6) {
		fila++;
		suma = 0;
		posicion = 0;
	}
	return { ...s, honda, enlace: s.precios ? `#${anclaPrecios(s.precios)}` : '#precios' };
});
---

<section class="servicios seccion tema-claro" id="servicios" aria-labelledby="titulo-servicios">
	<div class="contenedor">
		<h2 id="titulo-servicios">Lo que arreglamos</h2>
		<p class="intro">Si tiene chip, lo revisamos: computadoras, notebooks, consolas y netbooks. Estos son los trabajos que más nos piden.</p>

		<ul class="pozo">
			{
				piezas.map((s) => (
					<li class:list={['pieza', { 'pieza-honda': s.honda }]} style={`--ancho: ${s.ancho}`}>
						<h3>{s.titulo}</h3>
						<p>{s.texto}</p>
						<a class="ver-precios" href={s.enlace}>
							Ver precios<span class="solo-lectores"> de {s.precios ?? 'todos los servicios'}</span>
							<Icono nombre="arrow-down" />
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/* Cada fila suma 6 columnas: las piezas completan la línea, como en el logo */
	.pozo {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 6px;
		margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
		padding: 6px;
		list-style: none;
		background: var(--azul-950);
		border-radius: 10px;
	}

	/* Título y texto arriba; "Ver precios" siempre al pie, alineado en toda la fila */
	.pieza {
		grid-column: span var(--ancho);
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: 0.5rem;
		min-height: 11rem;
		padding: clamp(1.25rem, 2.5vw, 1.75rem);
		border-radius: var(--radio);
		background: #ffffff;
	}

	.pieza p {
		max-width: 36rem;
	}

	.pieza h3 {
		color: var(--tono-titulo, var(--titulo));
	}

	.pieza p {
		color: var(--tono-texto, var(--suave));
	}

	/* Chico a la vista, pero se toca en 3rem de alto */
	.ver-precios {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		justify-self: start;
		min-height: 3rem;
		margin-block: 0.25rem -0.75rem;
		color: var(--tono-enlace, var(--enlace));
		font: 700 1rem/1.2 var(--fuente-titulos);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.25em;
	}

	.ver-precios:hover {
		text-decoration-color: transparent;
	}

	.ver-precios:focus-visible {
		outline-color: var(--tono-foco, var(--azul-700));
	}

	.pieza-honda {
		--tono-titulo: #fff;
		--tono-texto: var(--azul-100);
		--tono-enlace: #fff;
		--tono-foco: #fff;
		background: var(--azul-700);
	}

	@media (max-width: 860px) {
		.pozo {
			grid-template-columns: 1fr;
		}
		/* En una sola columna el damero pasa a alternar de a uno */
		.pieza,
		.pieza-honda {
			--tono-titulo: var(--titulo);
			--tono-texto: var(--suave);
			--tono-enlace: var(--enlace);
			--tono-foco: var(--azul-700);
			grid-column: auto;
			min-height: 0;
			background: #fff;
		}
		.pieza:nth-child(even) {
			--tono-titulo: #fff;
			--tono-texto: var(--azul-100);
			--tono-enlace: #fff;
			--tono-foco: #fff;
			background: var(--azul-700);
		}
	}
</style>
