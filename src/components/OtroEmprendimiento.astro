---
import { otroEmprendimiento as e } from '../data/site';
import { ruta } from '../lib/ruta';
import Icono from './Icono.astro';
---

<section class="emprendimiento seccion tema-oscuro tema-alt" id="matelogic" aria-labelledby="titulo-emprendimiento">
	<div class="contenedor">
		<div class="tarjeta">
			<div class="marco" aria-hidden="true">
				<img src={ruta('brand/matelogic-isotipo.svg')} alt="" width="424" height="552" loading="lazy" />
			</div>
			<div class="texto">
				<p class="etiqueta">Otro emprendimiento · {e.nombre}</p>
				<h2 id="titulo-emprendimiento">{e.titulo}</h2>
				<p class="descripcion">{e.texto}</p>
				<a class="boton boton-secundario" href={e.url} target="_blank" rel="noopener">
					Conocé {e.nombre}
					<Icono nombre="arrow-top-right-on-square" />
					<span class="solo-lectores">(se abre en otra pestaña)</span>
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.emprendimiento {
		background: var(--sup-alt);
	}

	.tarjeta {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.5rem, 5vw, 4rem);
		max-width: 56rem;
		margin-inline: auto;
		padding: clamp(1.5rem, 5vw, 3.5rem);
		border: 1px solid var(--sup-borde-osc);
		border-radius: 14px;
		background:
			radial-gradient(28rem 20rem at 0% 50%, rgb(10 163 211 / 0.14), transparent 70%),
			var(--sup-tarjeta);
	}

	/* El isotipo tiene contornos oscuros: va sobre un círculo claro para que se lean */
	.marco {
		display: grid;
		place-items: center;
		width: clamp(7.5rem, 20vw, 11rem);
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--sup-claro);
		box-shadow: 0 0 0 6px rgb(10 163 211 / 0.18);
	}

	.marco img {
		width: 58%;
		height: auto;
	}

	.etiqueta {
		font: 600 0.9375rem/1.3 var(--fuente-titulos);
		color: var(--azul-300);
	}

	h2 {
		margin-top: 0.5rem;
	}

	.descripcion {
		max-width: 34rem;
		margin-top: 0.9rem;
		color: var(--suave);
		font-size: 1.0625rem;
	}

	.boton {
		margin-top: 1.5rem;
	}

	/* En celular el isotipo va arriba, centrado sobre el texto */
	@media (max-width: 640px) {
		.tarjeta {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
		}
		.descripcion {
			margin-inline: auto;
		}
		.marco {
			width: 7.5rem;
		}
	}
</style>
